#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>


&mt {
	tapping-term-ms = <180>;
	flavor = "tap-preferred";
};

&lt {
	tapping-term-ms = <180>;
};

&sk {
	release-after = <2000>;
	quick-release;
};

// Layers
#define LOW 1
#define RSE 2
#define ADJ 3

// Symbols
#define _SP         SPACE
#define _SQT        SQT //          ' @
#define _SCN        SEMI //         ; :
#define _COM        COMMA //        , <
#define _DOT        DOT  //         . >
#define _SL         SLASH //        / ?
#define _GBP        LS(N3) //       £
#define _PRC        LS(N5) //       %
#define _EUR        RA(N4) //       €
#define _BTK        GRAVE //        `
#define _QS         LS(SLASH) //    ?
#define _CRT        LS(N6) //       ^
#define _PIP        LS(NUBS) //     |
#define _CN         LS(SEMI) //     :
#define _UND        LS(MINUS) //    _
#define _MIN        MINUS //        -
#define _TLD        LS(NUHS) //     ~
#define _LSB        LBKT //         [
#define _RSB        RBKT //         ]
#define _LCB        LBRC //         {
#define _RCB        RBRC //         }
#define _LPR        LPAR //         (
#define _RPR        RPAR //         )
#define _LAB        LT //           <
#define _RAB        GT //           >
#define _PLS        LS(EQUAL) //    +
#define _EQ         EQUAL //        =
#define _USD        LS(N4) //       $
#define _AMP        LS(N7) //       &
#define _DQT        LS(N2) //       "
#define _AST        LS(N8) //       *
#define _HSH        NUHS //         #
#define _AT         LS(SQT) //      @
#define _EX         LS(N1) //       !
#define _BSL        NUBS //         \

// Media keys
#define _V_P        C_PLAY_PAUSE
#define _V_VD       C_VOLUME_DOWN
#define _V_VU       C_VOLUME_UP

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
			    /*          *           *           *           *           *          |*           *           *           *           *           */
				&kp TAB     &mt LGUI Q  &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &mt LGUI P  &kp BSPC
				&kp ESC     &mt LALT A  &mt LCTRL S &mt LSHFT D &kp F       &kp G       &kp H       &kp J       &mt LSHFT K &mt LCTRL L &mt LALT SEMI  &kp RET
                &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp SLASH   &kp DEL
                &none       &none       &none       &none       &none       &lt LOW _SP &mo RSE     &none       &none       &none       &none       &none
            >;
        };

        lower {
            bindings = <
			    /*          *           *           *           *           *          |*           *           *           *           *           */
				&none       &none       &kp N7      &kp N8      &kp N9      &none       &kp _RSB    &kp _PLS    &kp _AMP    &kp _LAB    &kp _PRC    &none
                &none       &kp N0      &kp N4      &kp N5      &kp N6      &none       &kp _RPR    &kp _DQT    &kp _USD    &kp _RAB    &none       &none
                &none       &none       &kp N1      &kp N2      &kp N3      &none       &kp _RCB    &kp _EQ     &kp _AST    &kp _HSH    &kp _EUR    &none
                &none       &none       &none       &none       &none       &trans      &mo ADJ     &none       &none       &none       &none       &none
            >;
        };

        raise {
            bindings = <
			    /*          *           *           *           *           *          |*           *           *           *           *           */
				&none       &kp _GBP    &kp _BTK    &kp _PIP    &kp _UND    &kp _LSB    &none       &none       &none       &none       &none       &none
                &none       &kp _CRT    &kp _EX     &kp _SQT    &kp _MIN    &kp _LPR    &none       &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &none
                &none       &none       &kp _AT     &kp _BSL    &kp _TLD    &kp _LCB    &none       &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &none
                &none       &none       &none       &none       &none       &mo ADJ     &trans      &none       &none       &none       &none       &none
            >;
        };

		adust {
			bindings = <
			    /*          *           *           *           *           *          |*           *           *           *           *           */
				&none       &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &none
                &none       &none       &kp _V_VD   &kp _V_VU   &kp _V_P    &kp F11     &kp F12     &kp _V_P    &kp _V_VU   &kp _V_VD   &none       &none
                &bootloader &kp CAPS    &none       &none       &none       &none       &none       &none       &none       &none       &kp CAPS    &bootloader
                &none       &none       &none       &none       &none       &trans      &trans      &none       &none       &none       &none       &none
			>;
		};
    };
};
